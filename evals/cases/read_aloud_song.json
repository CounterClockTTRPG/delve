  "beats": [
    {
      "player": "Bren and Pippa walk to the end of the passage and look at the grey door.",
      "expect": {
        "read_aloud": [
          {
            "told": "The door at the end of the passage is a single slab of dull grey metal."
          },
          {
            "told": "Lines of small runes are etched across it from edge to edge."
          },
          {
            "told": "The runes catch fire one by one in a crackle of green light"
          },
          {
            "heard": "Visitors again"
          },
          {
            "said": "The last ones did not leave."
          },
          {
            "told": "A dry laugh rolls out of the door."
          },
          {
            "said": "Sit, and answer me, and I will let you in."
          },
          {
            "told": "Then the door itself begins to sing"
          },
          {
            "told": "Two brothers raised a single wall,"
          },
          {
            "told": "And each one swore it would not fall."
          },
          {
            "told": "One took the north, and one the south,"
          },
          {
            "told": "With mortar's dust in either mouth."
          },
          {
            "told": "A storm came down, the wall split wide,"
          },
          {
            "told": "Each blamed the one on the other side."
          },
          {
            "told": "Then, back to back against the rain,"
          },
          {
            "told": "They held it up and built again."
          },
          {
            "heard": "what held the wall up?"
          }
        ]
      }
    }
  ]
}
